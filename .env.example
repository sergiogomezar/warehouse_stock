# Copy to .env and adjust. Values match docker-compose.yml.

# Database used by the app and the migration scripts.
DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse_stock

# Database used by `pnpm test:e2e`. Its tables are truncated between tests.
TEST_DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse_stock_test

# HTTP port (optional, default 3000).
PORT=3000
